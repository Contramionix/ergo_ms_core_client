{
  "name": "@ergo-ms/core-client",
  "version": "2.7.8",
  "private": true,
  "type": "module",
  "description": "Ядро системы ErgoMS - клиентская часть",
  "scripts": {
    "predev": "node scripts/generate-module-globs.js",
    "dev": "vite --host",
    "stop-dev": "node scripts/stop-dev.js",
    "prebuild": "node scripts/generate-module-globs.js",
    "build": "vite build",
    "build:analyze": "npm run prebuild && cross-env ANALYZE=true vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "lint:a11y": "eslint -c eslint.a11y.config.js \"src/**/*.{vue,js}\" --no-fix --max-warnings 200",
    "check-i18n": "node scripts/check-i18n-keys.js",
    "format": "prettier --write src/"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Edge versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 iOS versions",
    "not dead",
    "not ie 11"
  ]
}
